# Flow Pharma Environment Configuration
APP_NAME=Flow Pharma
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./flow_pharma.db
SYNC_DATABASE_URL=sqlite:///./flow_pharma.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://flow_user:flow_password@postgres:5432/flow_pharma
# SYNC_DATABASE_URL=postgresql://flow_user:flow_password@postgres:5432/flow_pharma

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Security
SECRET_KEY=flow-pharma-dev-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Policy & Jurisdiction
POLICY_JURISDICTION=IN
DEFAULT_MAX_ORDER_QUANTITY=10

# AI Provider (local / vllm / mock)
AI_PROVIDER=local
AI_BASE_URL=http://localhost:8000/v1
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
AI_TEMPERATURE=0.1

# Speech / Voice
WHISPER_MODEL=base
VOICE_PROVIDER=browser
UPLOAD_DIR=./uploads
PRESCRIPTION_UPLOAD_DIR=./uploads/prescriptions

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev

# Seeding
SEED_DEMO_DATA=true
AUTO_RUN_MIGRATIONS=true
